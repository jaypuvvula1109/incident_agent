# Copy this file to local.env and fill in your real values.
# local.env is git-ignored so your key never gets committed.
# Usage:  source local.env && go run . "INC-1001 checkout 5xx errors"

export AZURE_OPENAI_ENDPOINT="https://<your-resource>.openai.azure.com"
export AZURE_OPENAI_DEPLOYMENT="<your-deployment-name>"
export AZURE_OPENAI_API_KEY="<your-azure-openai-api-key>"

# Optional: path to the local DuckDB file (defaults to ./incidentagent.duckdb)
# export DUCKDB_PATH="./incidentagent.duckdb"
